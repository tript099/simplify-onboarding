# billing-agent — product-side billing PDP sidecar
BILLING_BASE_URL=http://core:8081      # SimplifyBilling core
BILLING_API_KEY=bk_replace_me          # product API key (admin → Integration → rotate)
AGENT_LISTEN=:8099                     # local API products/BFF call
AGENT_CACHE_TTL=45s                    # entitlement cache freshness
AGENT_FAIL_MODE=closed                 # closed = deny when core unreachable; open = allow

# --- Optional: Zitadel M2M auth instead of a static API key ---
# When set, the agent fetches short-lived tokens via client-credentials and
# presents them to core (which must validate them — see PLAN "Zitadel" section).
# ZITADEL_TOKEN_URL=https://<instance>.zitadel.cloud/oauth/v2/token
# ZITADEL_CLIENT_ID=
# ZITADEL_CLIENT_SECRET=
# ZITADEL_SCOPE=openid urn:zitadel:iam:org:project:id:<projectID>:aud

# Consumption write-back (report path). authorize is always synchronous.
AGENT_FLUSH_INTERVAL=2s
AGENT_FLUSH_SIZE=50
