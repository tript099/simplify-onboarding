# Simplify Onboarding Service — environment template.
# Copy to `.env` and fill in the secrets. The service is STANDALONE: it depends only on
# Zitadel (the shared IdP) + its OWN Redis + its OWN Postgres. MailForge (email) and the
# meeting scheduler are shared infrastructure reached over HTTP with a key/passcode.

APP_ENV=development
PORT=8090

# ── Identity (Zitadel — shared IdP) ─────────────────────────────────
IDENTITY_PROVIDER=zitadel
# Self-deployed Zitadel (shared org = central SSO); onboarding has its own project + service user.
ZITADEL_ISSUER=https://auth.simplifyai.id
ZITADEL_INTERNAL_URL=https://auth.simplifyai.id
# PKCE app under the "Onboarding" project; service PAT = dedicated onboarding SA (ORG_OWNER + IAM_OWNER)
ZITADEL_CLIENT_ID=
ZITADEL_SERVICE_PAT=
ZITADEL_ORG_ID=
# Federated SSO — the Zitadel IdP ids for Google / Microsoft
IDP_GOOGLE_ID=
IDP_MICROSOFT_ID=

# ── Own session store (Redis) + database (Postgres) ─────────────────
REDIS_URL=redis://onboarding-redis:6379
REDIS_DB=0
ONBOARDING_DATABASE_URL=postgres://onboarding:onboarding@onboarding-db:5432/onboarding?sslmode=disable
SESSION_PERSIST=true

# ── Cookies / CORS / frontend ───────────────────────────────────────
COOKIE_SECURE=false
# COOKIE_DOMAIN=.simplifyaipro.com   # prod: share cookie across product subdomains
FRONTEND_URL=http://localhost:3100
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3000
DEBUG_RETURN_CODE=false
SIMPLIFYCORE_STUB=true

# Guards the internal POST /onb/demo/{id}/schedule endpoint (leave empty in dev).
INTERNAL_JWT_SECRET=

# ── Demo account ("Try it now") ─────────────────────────────────────
DEMO_ENABLED=true
DEMO_EMAIL=demo@simplifyai.id
DEMO_PASSWORD=
DEMO_FIRST_NAME=Simplify
DEMO_LAST_NAME=Demo

# ── Email (MailForge — shared service, dedicated onboarding project key) ─
MAILFORGE_URL=http://host.docker.internal:8099
MAILFORGE_API_KEY=               # mf_proj_… send key for the "Simplify Onboarding" project
MAILFORGE_FROM_NAME=Simplify
MAILFORGE_FROM_EMAIL=no-reply@simplifyai.id
MAILFORGE_REPLY_TO=sales@simplifyai.id
DEMO_RECIPIENTS_FILE=/app/config/demo-recipients.json

# ── Meeting scheduler (shared service) ──────────────────────────────
# /schedule_teams works today; /schedule_google currently 500s on the scheduler.
SCHEDULER_URL=https://scheduler.simplifyaipro.com
SCHEDULER_PATH=/schedule_google
SCHEDULER_PASSCODE=
SCHEDULER_DURATION_MIN=30

# MailForge template ids (provisioned via scripts/provision-email-templates.py)
MAILFORGE_TEMPLATE_CONFIRMATION=
MAILFORGE_TEMPLATE_TEAM_NOTIFY=
MAILFORGE_TEMPLATE_INVITE=

# Simplify Core — product catalog source (names/taglines/launch URLs/logos)
SIMPLIFYCORE_BASE_URL=https://api-dev.simplifyaipro.com
SIMPLIFYCORE_CATALOG_APP_ID=simplify-core

# SMS OTP via Zitadel HTTP SMS provider → forwarded to your transport (any provider, not
# just Twilio). See scripts/setup-zitadel-sms.sh + SMS_OTP_SETUP.md.
SMS_WEBHOOK_SIGNING_KEY=            # from setup-zitadel-sms.sh output (verifies ZITADEL-Signature)
SMS_WEBHOOK_VERIFY=true             # set false only for first-run testing
SMS_PROVIDER=http                  # http (generic gateway) | sns (AWS SNS)

# --- Transport A: AWS SNS (SMS_PROVIDER=sns) — SNS is transport only; Zitadel makes the OTP ---
SMS_SNS_REGION=ap-southeast-1       # a region that supports SMS; empty = log OTP only (no send)
SMS_SNS_SENDER_ID=                  # optional alphanumeric sender id (country-permitting)
SMS_SNS_TYPE=Transactional         # Transactional (OTP) | Promotional
# AWS creds via the standard chain — set these (or use an IAM role) with sns:Publish:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Transport B: generic HTTP gateway (SMS_PROVIDER=http) ---
SMS_PROVIDER_URL=                  # gateway send endpoint; empty = log OTP only (no send)
SMS_PROVIDER_METHOD=POST
SMS_PROVIDER_CONTENT_TYPE=application/json
SMS_PROVIDER_AUTH_HEADER=          # e.g. "Authorization: Bearer xxx" or "X-API-Key: xxx"
SMS_PROVIDER_BODY_TEMPLATE={"to":"{{phone}}","message":"{{text}}"}   # {{phone}} + {{text}} substituted

# Core Account API (per-product subscriptions by email) — HMAC key from admin → Integration
ACCOUNT_API_KEY=
ACCOUNT_API_SECRET=
